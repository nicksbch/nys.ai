{
  "servers": [
    {"name": "vigil", "url": "http://127.0.0.1:8090/mcp", "token_env": "VIGIL_MCP_TOKEN"},
    {"name": "semantic", "url": "http://127.0.0.1:8097/mcp", "token_env": "SEMANTIC_MCP_TOKEN"},
    {"name": "url-to-bucket", "url": "http://127.0.0.1:8093/mcp", "token_env": "URL_TO_BUCKET_MCP_TOKEN"}
  ],
  "profiles": {
    "oncall": {"servers": ["vigil", "url-to-bucket"], "allow": ["vigil__list_events", "vigil__get_run", "vigil__list_jobs", "vigil__list_alerts", "url-to-bucket__download"]},
    "analyst": {"servers": ["semantic"]},
    "nexus": {"servers": ["url-to-bucket"], "allow": ["url-to-bucket__download", "url-to-bucket__list_buckets"]}
  }
}
