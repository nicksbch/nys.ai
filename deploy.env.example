# Settings for deploy-all.sh. Copy to deploy.env and uncomment what you need.
# deploy.env can hold secrets (webhook URL, llama API key): keep it out of git.
#
# Each setting carries its step's prefix and is passed to that step only,
# without the prefix (VIGIL_EXPECT -> EXPECT for vigil). Anything left
# commented out uses the default from the step's own script, shown here.
#
# Some steps rewrite their config on every deploy, so a value set once by
# hand on the server is lost unless it is here too:
#   vigil      DISKS, EXPECT, EXTRA_ARGS (systemd unit)
#   relay      LISTEN, EXTRA_ARGS (systemd unit)
#   garage-ui  LISTEN (systemd unit); BUCKETS are granted again each run
#   url-to-bucket  WORKERS, LISTEN (systemd unit); BUCKETS are granted again each run
#   lake-ui    LISTEN (systemd unit)
#   lakeshape  the project (PROJECT), on every deploy
#   semantic   LISTEN (systemd unit); LAKE_BUCKET is granted again each run
#   mcp-hub    LISTEN, EXTRA_ARGS (systemd unit)
#   foreman    LISTEN, EXTRA_ARGS (systemd unit)
#   analyst    LISTEN, EXTRA_ARGS (systemd unit)
#   home       LISTEN, SERVICES (systemd unit)
#   llama      everything (/etc/llama-server.env)
# The defaults below match what was on the server on 2026-10-19.

# --- Server ------------------------------------------------------------------
#HOST=192.168.1.169
#SSH_PORT=2222

# --- garage (linux-scripts/garage-setup.sh) ----------------------------------
# A new GARAGE_VERSION installs the binary, but garage is only restarted on
# the new version by: sudo systemctl restart garage
#GARAGE_VERSION=v2.4.1
#GARAGE_CAPACITY=200G
#GARAGE_ZONE=dc1
#GARAGE_BUCKET=home
#GARAGE_KEY_NAME=home-key
#GARAGE_S3_BIND=[::]:3900
#GARAGE_WEB_BIND=[::]:3902

# --- vigil -------------------------------------------------------------------
#VIGIL_LISTEN=[::]:8090
#VIGIL_DISKS="/ /var/lib/garage"
#VIGIL_EXPECT="url-to-bucket/download=24h"
#VIGIL_UI_USER=admin
#VIGIL_WEBHOOK=https://hooks.slack.com/services/...   # first install only
#VIGIL_EXTRA_ARGS="-disk-warn 90"

# --- relay -------------------------------------------------------------------
#RELAY_LISTEN=[::]:8091
#RELAY_EXTRA_ARGS="-retention 720h"

# --- duckpipe (only with ONLY=duckpipe) --------------------------------------
# The pipes are duckpipe/duckpipe.yaml in the repo, installed on every deploy.
#DUCKPIPE_SOURCE_BUCKETS=home
#DUCKPIPE_LAKE_BUCKET=lake
#DUCKPIPE_KEY_NAME=duckpipe-key
#DUCKPIPE_ENDPOINT=http://127.0.0.1:3900
#DUCKPIPE_DUCKDB_VERSION=v1.5.6

# --- ducklake (linux-scripts/ducklake-setup.sh) ------------------------------
#DUCKLAKE_LAKE_BUCKET=lake
#DUCKLAKE_KEY_NAME=ducklake-key
#DUCKLAKE_PG_DB=ducklake
#DUCKLAKE_PG_USER=ducklake
#DUCKLAKE_S3_ENDPOINT=http://127.0.0.1:3900
#DUCKLAKE_DUCKDB_VERSION=v1.5.6
#DUCKLAKE_LAN_CIDR=192.168.1.0/24   # default: detected; empty = localhost only
#DUCKLAKE_HOST_IP=192.168.1.169     # default: detected

# --- garage-ui ---------------------------------------------------------------
#GARAGE_UI_LISTEN=[::]:8080
#GARAGE_UI_BUCKETS="home"
#GARAGE_UI_KEY_NAME=garage-ui-key
#GARAGE_UI_UI_USER=admin
#GARAGE_UI_ENDPOINT=http://127.0.0.1:3900

# --- lake-ui -----------------------------------------------------------------
#LAKE_UI_LISTEN=[::]:8092
#LAKE_UI_LAKE_BUCKET=lake
#LAKE_UI_KEY_NAME=lake-ui-key
#LAKE_UI_PG_ROLE=lake_ui
#LAKE_UI_UI_USER=admin
#LAKE_UI_ENDPOINT=http://127.0.0.1:3900

# --- lakeshape ---------------------------------------------------------------
# PROJECT is relative to this directory.
#LAKESHAPE_PROJECT=analytics
#LAKESHAPE_LAKE_BUCKET=lake
#LAKESHAPE_KEY_NAME=lakeshape-key
#LAKESHAPE_ENDPOINT=http://127.0.0.1:3900
#LAKESHAPE_DUCKDB_VERSION=v1.5.6

# --- semantic ----------------------------------------------------------------
# The models are semantic/models.yml in the repo, installed on every deploy.
#SEMANTIC_LISTEN=[::]:8097
#SEMANTIC_LAKE_BUCKET=lake
#SEMANTIC_KEY_NAME=semantic-key
#SEMANTIC_PG_ROLE=semantic
#SEMANTIC_ENDPOINT=http://127.0.0.1:3900   # first install only

# --- url-to-bucket -----------------------------------------------------------
#URL_TO_BUCKET_BUCKETS=home             # buckets its key may write to
#URL_TO_BUCKET_KEY_NAME=url-to-bucket-key
#URL_TO_BUCKET_WORKERS=2
#URL_TO_BUCKET_ENDPOINT=http://127.0.0.1:3900
#URL_TO_BUCKET_LISTEN=[::]:8093
#URL_TO_BUCKET_UI_USER=admin            # first install only

# --- mcp-hub -----------------------------------------------------------------
# Servers and profiles are mcp-hub/servers.json in the repo, installed on
# every deploy. Change them there, not on the server.
#MCP_HUB_LISTEN=[::]:8094
#MCP_HUB_EXTRA_ARGS=

# --- foreman -----------------------------------------------------------------
# Agents, task types and models are foreman/config/ in the repo, installed on
# every deploy. Change them there, not on the server.
#FOREMAN_LISTEN=[::]:8096
#FOREMAN_EXTRA_ARGS="-concurrency 2"

# --- analyst -----------------------------------------------------------------
# Models and the prompt are analyst/config/ in the repo, installed on every
# deploy. Change them there, not on the server.
#ANALYST_LISTEN=[::]:8098
#ANALYST_EXTRA_ARGS="-max-steps 12 -timeout 10m"

# --- home --------------------------------------------------------------------
#HOME_LISTEN=[::]:8000
#HOME_SERVICES="vigil=8090 relay=8091/ui garage-ui=8080 lake-ui=8092 url-to-bucket=8093 foreman=8096/ui"

# --- llama (only with ONLY=llama) --------------------------------------------
#LLAMA_REF=master
#LLAMA_MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
#LLAMA_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
#LLAMA_HOST=127.0.0.1
#LLAMA_PORT=8081
#LLAMA_API_KEY=
#LLAMA_CTX=16384
#LLAMA_THREADS=   # default: physical cores
